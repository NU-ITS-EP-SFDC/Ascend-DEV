<apex:page controller="iWave_PROscores.GenerateProScoreController" lightningStylesheets="true">
<apex:stylesheet value="{! URLFOR($Resource.FontAwesome, '/font-awesome-4.4.0/css/font-awesome.min.css') }" />
<apex:stylesheet value="{! URLFOR($Resource.ProScoreCSS) }" />

<!--
	Using apex:includeScript puts files in the head tag. document.ready() only waits for resources to be
	loaded from within the body tag. Otherwise we probably want window.load()...
-->
<script src="{! URLFOR($Resource.jQuery) }" type="text/javascript"></script>
<script src="../../soap/ajax/44.0/connection.js" type="text/javascript"></script>
<script src="../../soap/ajax/44.0/apex.js" type="text/javascript"></script>

<script>
    $(document).ready(function() {
    	doActionWithValidatedCredentials(getScoreForRecord);
	});

	function watchPendingStatus(requestId, objectToScoreId, objectToScoreType) {
		setTimeout(function () {
			isStillPending(requestId, objectToScoreId, objectToScoreType);
		}, 10000);
	}

	function removePendingScore(pendingScoreId) {
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.GenerateProScoreController.removePendingScore}', pendingScoreId,
			function (result, event) {
				//should be deleted now
			}
		);
	}

	function isStillPending(requestId, objectToScoreId, objectToScoreType) {
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.GenerateProScoreController.getPendingScore}', Number(requestId), String(objectToScoreId), String(objectToScoreType),
			function (result, event) {
				if (result != null && !result.iWave_PROscores__isStillPending__c) {
					removePendingScore(result.Id);
					document.location.replace('/apex/iWave_PROscores__iWavePROScoreDetailView?id=' + result.iWave_PROscores__ProScoreId__c);
				} else {
					watchPendingStatus(requestId, objectToScoreId, objectToScoreType);
				}
			}
		);
	}

	function getScoreForRecord() {
		var id = '{! JSENCODE($CurrentPage.parameters.id) }';
		var cid = '{! JSENCODE($CurrentPage.parameters.cid) }';
		var lid = '{! JSENCODE($CurrentPage.parameters.lid) }';
		
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.GenerateProScoreController.generateScoreForRecord}',
			id, cid, lid, 'Client',

			function (result, event) {
				if (!result) {
					$('[id$=scoreHeaderMessage]').html('Please click OK to return to the record you were attempting to score.');
				} else if (result.success && result.extra.requestId) {
					watchPendingStatus(result.extra.requestId, result.extra.objectToScoreId, result.extra.objectToScoreType);
				} else if (result.success && result.extra.scoreId) {
					document.location.replace('/apex/iWave_PROscores__iWavePROScoreDetailView?id=' + result.extra.scoreId);
				} else {
					addPageErrorMessage(result.message);
					if (!result.credentials_success) {
						showCredentialsModal(getScoreForRecord, 'Please update your credentials.');
					} else {
						addPageErrorMessage(result.message);
						
						if (!result.credentials_success) {
							showCredentialsModal(getScoreForRecord, 'Please update your credentials.');
						} else {
							$('[id$=scoreHeaderMessage]').html('Please click OK to return to the record you were attempting to score.');
						}
					}
				}
			}
		, {timeout: 120000});
	}
</script>

<apex:form >
  <apex:actionFunction name="addPageErrorMessage" action="{!addPageErrorMessage}" rerender="scoreMessages">
    <apex:param name="errorMessage" assignTo="{!errorMessage}" value=""/>
  </apex:actionFunction>
  <apex:actionFunction name="returnToRecord" action="{!returnToRecord}"/>
  <apex:pageMessages id="scoreMessages"/>
  <apex:pageBlock id="scoreHeaderBlock">
        <div align="center">
        <apex:outputPanel id="scoreHeaderPanel">
          <strong><div id="scoreHeaderMessage">Calculating Score. This may take several minutes. You can continue working while the calculation is processed and find the results within the contact or lead when the process is complete.</div></strong>
        </apex:outputPanel>
        </div>
        <apex:pageBlockButtons location="bottom" id="scoresButtons">
    			<apex:commandButton value="OK" immediate="true" id="okBtn" action="{!returnToRecord}"/>
    		</apex:pageBlockButtons>
  </apex:pageBlock>
	  <c:ProScoreCredentialsModal />
  </apex:form>
</apex:page>