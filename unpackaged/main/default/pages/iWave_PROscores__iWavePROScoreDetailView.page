                                    <!--<span class="showScoreDetails" onclick="javascript: showDetails();">Show Details &raquo;</span>-->
                                </div>

                                <div class="score-detail-rows">
                                    <h3 class="proscore_score_breakdown" style = 'padding-left:10px;'>
