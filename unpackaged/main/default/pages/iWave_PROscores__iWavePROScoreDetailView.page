                                        Propensity to Give
                                    </h3>
                                    <h3 class="proscore_score_breakdown" style = 'padding-left:10px;'>
                                        <img src="{! $Resource.badgeIcons }/secondary-score-0{! theScore['Affinity_Score__c'] }--lg.svg" />
                                        Affinity {! theAffinityDescription }
                                    </h3>
                                    <h3 class="proscore_score_breakdown" style = 'padding-left:10px;'>
                                        <img src="{! $Resource.badgeIcons }/secondary-score-0{! theScore['Capacity_Score__c'] }--lg.svg" />
                                        Estimated Capacity to Give
                                    </h3>
                                </div>
                            </div>
                            <!-- iwave score end -->

                            <div id="proscore_box_details" class="proscore_box proscore-{! theScore['PRO_Score__c'] }" style="display: none;">
                                <ul class="details">
                                    <li class="proscore-{! theScore['Propensity_Score__c'] }"><span>{! theScore['Propensity_Score__c'] }</span>Propensity</li>
                                    <li class="proscore-{! theScore['Affinity_Score__c'] }"><span>{! theScore['Affinity_Score__c'] }</span>Affinity</li>
