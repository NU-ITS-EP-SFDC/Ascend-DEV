<apex:page controller="iWave_PROscores.iWavePROScoreDetailViewController" lightningStyleSheets="true">
    <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <apex:stylesheet value="{! URLFOR($Resource.FontAwesome, '/font-awesome-4.4.0/css/font-awesome.min.css') }" />
    <apex:stylesheet value="{! URLFOR($Resource.ProScoreCSS) }" />
    <apex:includeScript value="{! URLFOR($Resource.jQuery) }" />
    <script src="../../soap/ajax/44.0/connection.js" type="text/javascript"></script>
    <script src="../../soap/ajax/44.0/apex.js" type="text/javascript"></script>
    <script>
    $(document).ready(function(){
        doActionWithValidatedCredentials(promoteToProfileOrLink);
        $('#back-to-contact').click(backToResource);
        
        $('.format-est-cap-range').each(function(){
            let num = $(this).text();
            num = parseFloat(num).toLocaleString('en');
            $(this).text(num);
        });
    });

    function showPleaseWait(){
        $('#promote-profile').css('display','none');
        $('#please-wait').toggle();
    }


    function backToResource() {
        window.location = '/' + '{! objectToScore['Id'] }';
    }

    function promoteToProfileOrLink(){

        var dmsId = '{! HTMLENCODE(dmsId) }';
        var isPromoted = '{! hasProfile }';
        var profileUrl = '{! HTMLENCODE(profileUrl) }';

        if (profileUrl !== '' && isPromoted !== 'false') {
            showLinkToProfileButton();
        } else if (dmsId && dmsId !== '' && isPromoted !== 'false') {
            showLinkToProfileButton();
        } else {
            showPromoteToProfileButton();
        }
    }

    function showLinkToProfileButton(){
        var dmsId = '{! HTMLENCODE(dmsId) }';
        var profileUrl = '{! HTMLENCODE(profileUrl) }';

        $('#promote-profile').css('display','none');
        $('#please-wait').css('display','none');
        $('#link-to-profile').toggle();

        if (profileUrl !== '') {
            $('#link-to-profile').html("<a target = '_BLANK' href = '{! HTMLENCODE(profileUrl) }'>Link to Profile </a>");
        } else {
            $('#link-to-profile').html("<a target = '_BLANK' href = '{! HTMLENCODE(proRootUrl) }/api/goto/profile-dms/" + '{! HTMLENCODE(dmsId) }' + "'>Link to Profile </a>");
        }
    }

    function showPromoteToProfileButton(){
        $('#promote-profile').click(showPleaseWait);
    }

    function showDetails() {
        document.getElementById('proscore_box_summary').style.display = 'none';
        document.getElementById('proscore_box_details').style.display = 'block';
    }

    function hideDetails() {
        document.getElementById('proscore_box_details').style.display = 'none';
        document.getElementById('proscore_box_summary').style.display = 'block';
    }
    </script>
    <apex:form >
        <apex:pageBlock >
            <div class="proscore-details-view" style = 'margin-top:15px;'>

                <div style = 'padding-left:30px;float:left;'>
                    <span style = 'font-size:30px;font-weight:bold;'>{! objectToScore['Name'] }</span>
                    <div class="insights-icon" style="display: {! IF(theScore['Insights__c'] == '', 'none', 'inline-block') };">
                        <img src="{! URLFOR($Resource.insightsIcons, 'analytics-icons/diamond-circle.png') }" title="Insights - Hidden Gem" style="display: {! IF(theScore['Insights__c'] == 'Hidden Gem', 'block', 'none') };" />
                        <img src="{! URLFOR($Resource.insightsIcons, 'analytics-icons/giftbox-circle.png') }" title="Insights - Distinguished Philanthropist" style="display: {! IF(OR(theScore['Insights__c'] == 'Distinguished Philanthropist', theScore['Insights__c'] == 'Distinguished'), 'block', 'none') };" />
                        <img src="{! URLFOR($Resource.insightsIcons, 'analytics-icons/pause-circle.png') }" title="Insights - Not Now Prospect" style="display: {! IF(OR(theScore['Insights__c'] == 'Not Now Prospect', theScore['Insights__c'] == 'Not Now'), 'block', 'none') };" />
                        <img src="{! URLFOR($Resource.insightsIcons, 'analytics-icons/trophy-circle.png') }" title="Insights - Your Champion" style="display: {! IF(OR(theScore['Insights__c'] == 'Your Champion', theScore['Insights__c'] == 'Champion'), 'block', 'none') };" />
                    </div>
                    <div class="insights-icon" style="display: {! IF(theScore['Cultivation__c'] == null, 'none', IF(theScore['Cultivation__c'] != '', 'inline-block', 'none')) }">
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_cul_story.png') }" title="Cultivation - Storytelling" style="display: {! IF(theScore['Cultivation__c'] == 'storytelling', 'block', 'none') };" />
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_cul_person.png') }" title="Cultivation - Personalization" style="display: {! IF(theScore['Cultivation__c'] == 'personalization', 'block', 'none') };" />
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_cul_annual.png') }" title="Cultivation - Annual" style="display: {! IF(theScore['Cultivation__c'] == 'annual', 'block', 'none') };" />
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_cul_research.png') }" title="Cultivation - Research-Driven" style="display: {! IF(theScore['Cultivation__c'] == 'research driven', 'block', 'none') };" />
                    </div>
                    <div class="insights-icon" style="display: {! IF(theScore['Engagement__c'] == null, 'none', IF(theScore['Engagement__c'] != '', 'inline-block', 'none')) }">
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_eng_team.png') }" title="Engagement - Team" style="display: {! IF(theScore['Engagement__c'] == 'team', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_eng_leader.png') }" title="Engagement - Leadership" style="display: {! IF(theScore['Engagement__c'] == 'leadership', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_eng_social.png') }" title="Engagement - Social" style="display: {! IF(theScore['Engagement__c'] == 'social', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_eng_ambass.png') }" title="Engagement - Ambassador" style="display: {! IF(theScore['Engagement__c'] == 'ambassador', 'block', 'none') }"/>
                    </div>
                    <div class="insights-icon" style="display: {! IF(theScore['Giving_Velocity__c'] == null, 'none', IF(theScore['Giving_Velocity__c'] != '', 'inline-block', 'none')) }">
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_vel_accel.png') }" title="Giving Velocity - Accelerating" style="display: {! IF(theScore['Giving_Velocity__c'] == 'accelerating', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_vel_decel.png') }" title="Giving Velocity - Decelerating" style="display: {! IF(theScore['Giving_Velocity__c'] == 'decelerating', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.analyticsIcons, '/circle_vel_steady.png') }" title="Giving Velocity - Steady" style="display: {! IF(theScore['Giving_Velocity__c'] == 'steady', 'block', 'none') }"/>
                    </div>
                    <div class="insights-icon" style="display: {! IF(theScore['Planned_Giving_Score__c'] == null, 'none', IF(theScore['Planned_Giving_Score__c'] != '', 'inline-block', 'none')) }">
                        <img src="{! URLFOR($Resource.pgIcons, '/circle_pg_1not.png') }" title="Not a Planned Giver" style="display: {! IF(theScore['Planned_Giving_Segment__c'] == 'Planned Giving - Not a Planned Giver', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.pgIcons, '/circle_pg_2potential.png') }" title="Potential Planned Giver" style="display: {! IF(theScore['Planned_Giving_Segment__c'] == 'Planned Giving - Potential Planned Giver', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.pgIcons, '/circle_pg_3strong.png') }" title="Strong Planned Giving Prospect" style="display: {! IF(theScore['Planned_Giving_Segment__c'] == 'Planned Giving - Strong Planned Giving Prospect', 'block', 'none') }"/>
                        <img src="{! URLFOR($Resource.pgIcons, '/circle_pg_4ideal.png') }" title="Ideal Planned Giver" style="display: {! IF(theScore['Planned_Giving_Segment__c'] == 'Planned Giving - Ideal Planned Giver', 'block', 'none') }"/>
                    </div>
