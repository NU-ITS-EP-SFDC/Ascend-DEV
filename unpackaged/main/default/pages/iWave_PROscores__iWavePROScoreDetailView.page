                                <use xlink:href="{! URLFOR($Resource.icons, 'utility-sprite/svg/symbols.svg') }#check"></use>
                            </svg>
                        </span>
                        <span class="verified-text">{! IF(isVerified, 'Verified', 'Unverified') }</span>
                    </div>
                    <span style = 'font-weight:bold;'>Created Date: <apex:outputField value="{! theScore['CreatedDate'] }"/></span>
                </div>
                <div style = 'padding-right:30px;float:right;padding-top:15px;'>
                    <apex:outputPanel id="renderErrorMessage" >
                        <script>
                            var errorMessage = '{! errorMessage}';
                            var successful = {! successful};

                            function showResultOfPromoteProfile() {
                                if (successful){
                                    showLinkToProfileButton();
                                }
                                else {
                                    $('#promote-profile').css('display','none');//hide
                                    $('#please-wait').css('display','none');//hide
                                    $('#problem-promoting').toggle();//show
                                    if (errorMessage){
                                        $('#problem-promoting').html(errorMessage);
                                    }
                                }
                            }
                        </script>
                    </apex:outputPanel>
                    <apex:outputPanel onclick="promoteOrLinkToProfileJs()" styleClass=""  id="promoteProfileButtons"><span class="createProfileBtn" id = 'promote-profile'>Create Profile</span></apex:outputPanel>
                    <span class = 'pleaseWaitBtn' id = 'please-wait'>Promoting... please wait.</span>
                    <span class = 'linkToProfileBtn' id = 'link-to-profile'></span>
                    <span class = 'problemPromotingProfile' id = 'problem-promoting'>There was a problem promoting your contact to a profile. Please contact <a href="mailto:support@iwave.com">support@iwave.com</a></span>
                    <span class = 'returnToContactBtn'  id = 'back-to-contact'>Return to {! IF(objectToScoreType == 'Contact', 'Contact', 'Lead') }</span>
                </div>
                <div style='clear:both;'></div>
                <apex:pageBlockSection columns="3">
                    <apex:pageBlockSectionItem >
                        <apex:pageBlockSection columns="1">
