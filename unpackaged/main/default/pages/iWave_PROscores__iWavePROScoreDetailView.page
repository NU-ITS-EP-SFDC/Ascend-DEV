                                    <img src="{! URLFOR($Resource.badgeIcons, 'iwave-score-02--lg.svg') }" style="display: {! IF(theScore['PRO_Score__c'] == 2, 'block', 'none') };" />
                                    <img src="{! URLFOR($Resource.badgeIcons, 'iwave-score-03--lg.svg') }" style="display: {! IF(theScore['PRO_Score__c'] == 3, 'block', 'none') };" />
