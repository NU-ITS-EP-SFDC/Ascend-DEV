                            </div>

                            <!-- rfm score BEGIN -->
                            <div class="score-group" style="display: {! IF(theScore['RFM_Score__c'] == null, 'none', IF(theScore['RFM_Score__c'] > 0, '', 'none')) }">
                                <div id="proscore_box_summary">
                                    <img src="{! URLFOR($Resource.badgeIcons, 'RFM-score-00--lg.svg') }" style="display: {! IF(theScore['RFM_Score__c'] <  1, 'block', 'none') };" />
                                    <img src="{! URLFOR($Resource.badgeIcons, 'RFM-score-01--lg.svg') }" style="display: {! IF(theScore['RFM_Score__c'] == 1, 'block', 'none') };" />
                                    <img src="{! URLFOR($Resource.badgeIcons, 'RFM-score-02--lg.svg') }" style="display: {! IF(theScore['RFM_Score__c'] == 2, 'block', 'none') };" />
                                    <img src="{! URLFOR($Resource.badgeIcons, 'RFM-score-03--lg.svg') }" style="display: {! IF(theScore['RFM_Score__c'] == 3, 'block', 'none') };" />
                                    <img src="{! URLFOR($Resource.badgeIcons, 'RFM-score-04--lg.svg') }" style="display: {! IF(theScore['RFM_Score__c'] == 4, 'block', 'none') };" />
                                </div>
                                <div class="score-detail-rows">
                                    <h3 class="proscore_score_breakdown" style = 'padding-left:10px;'>
                                        <img src="{! $Resource.badgeIcons }/secondary-score-0{! theScore['RFM_Recency_Score__c'] }--lg.svg" />
                                        Recency
                                    </h3>
                                    <h3 class="proscore_score_breakdown" style = 'padding-left:10px;'>
                                        <img src="{! $Resource.badgeIcons }/secondary-score-0{! theScore['RFM_Frequency_Score__c'] }--lg.svg" />
                                        Frequency
                                    </h3>
                                    <h3 class="proscore_score_breakdown" style = 'padding-left:10px;'>
                                        <img src="{! $Resource.badgeIcons }/secondary-score-0{! theScore['RFM_Monetary_Score__c'] }--lg.svg" />
                                        Monetary
                                    </h3>
                                </div>
                            </div>
                            <!-- rfm score END -->

                           	<div style = ''>

                                <table class="proscore-table">
                                    <thead>
                                        <tr><th colspan="2"><label class='font_style_header'>Additional Score Details</label></th></tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><label class='font_style'>Capacity Range: </label></td><td><label class='font_style'>{! formattedCapacityRange }</label></td></tr>
                                        <tr><td><label class='font_style'>Capacity/5 year: </label></td><td><label class='font_style'>${! formattedCapacityValue }</label></td></tr>
                                        <tr><td><label class='font_style'>Common Name Score: </label></td><td><label class='font_style'>{! theScore['Common_Name_Score__c'] }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Primary Affinity </label></td><td><label class='font_style'>{! theScore['Primary_Affinity_Description__c'] }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Primary Affinity Score </label></td><td><label class='font_style'>{! theScore['Primary_Affinity_Score__c'] }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Secondary Affinity </label></td><td><label class='font_style'>{! theScore['Secondary_Affinity_Description__c'] }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Secondary Affinity Score: </label></td><td><label class='font_style'>{! theScore['Secondary_Affinity_Score__c'] }</label><br /></td></tr>
                                    </tbody>

                                    <tbody><tr><td colspan="2">&nbsp;</td></tr></tbody>

                                    <thead>
                                        <tr><th colspan="2"><label class='font_style_header'>Giving Breakdown</label></th></tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><label class='font_style'>Value of Donations: </label></td><td><label class='font_style'>${! formattedDonationsValue }</label></td></tr>
                                        <tr><td><label class='font_style'>Number of Donations: </label></td><td><label class='font_style'>{! theScore['Total_Donations_Number__c'] }</label></td></tr>
                                        <tr><td><label class='font_style'>Value of Properties: </label></td><td><label class='font_style'>${! formattedPropertiesValue }</label></td></tr>
                                        <tr><td><label class='font_style'>Number of Properties: </label></td><td><label class='font_style'>{! theScore['Total_Properties_Number__c'] }</label></td></tr>
                                    </tbody>

                                    <tbody><tr><td colspan="2">&nbsp;</td></tr></tbody>

                                    <thead>
                                        <tr><th colspan="2"><label class='font_style_header'>Planned Giving</label></th></tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><label class='font_style'>Score: </label></td><td><label class='font_style'>{! theScore['Planned_Giving_Score__c'] }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Segment: </label></td><td><label class='font_style'>{! theScore['Planned_Giving_Segment__c'] }</label><br /></td></tr>
                                    </tbody>

                                    <tbody><tr><td colspan="2">&nbsp;</td></tr></tbody>

                                    <thead>
                                        <tr><th colspan="2"><label class='font_style_header'>Other Information</label></th></tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><label class='font_style'>Insider: </label></td><td><label class='font_style'>{! IF(theScore['Has_Sec_Insider_Filings__c'], 'Yes', 'No') }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Business Affiliation: </label></td><td><label class='font_style'>{! IF(theScore['Has_Business_Affiliation__c'], 'Yes', 'No') }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Business Affiliation Business Name: </label></td><td><label class='font_style'>{! theScore['Business_Affiliation_Business_Name__c'] }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Corporate Title: </label></td><td><label class='font_style'>{! theScore['Business_Affiliation_Corporate_Title__c'] }</label><br /></td></tr>
                                        <tr><td><label class='font_style'>Business Email: </label></td><td><label class='font_style'>{! theScore['BusEmail__c'] }</label><br /></td></tr>
