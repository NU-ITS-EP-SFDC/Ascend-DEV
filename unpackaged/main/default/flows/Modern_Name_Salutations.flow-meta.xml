    <formulas>
        <description>This stores the logic for the Modern Name salutation format when in different households</description>
        <name>fx_Joint_ModernName</name>
        <dataType>String</dataType>
        <expression>IF( {!$Record.AccountId} = {!$Record.ucinn_ascendv2__Preferred_Spouse__r.AccountId},
IF(
{!$Record.LastName} = {!$Record.ucinn_ascendv2__Preferred_Spouse__r.LastName},
{!$Record.Account.ucinn_ascendv2__Primary_Contact__r.FirstName} + &apos; and &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.ucinn_ascendv2__Preferred_Spouse__r.FirstName} + &apos; &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.LastName},
{!$Record.Account.ucinn_ascendv2__Primary_Contact__r.FirstName} + &apos; &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.LastName} + &apos; and &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.ucinn_ascendv2__Preferred_Spouse__r.FirstName} + &apos; &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.ucinn_ascendv2__Preferred_Spouse__r.LastName}
),
IF( {!$Record.LastName} = {!$Record.ucinn_ascendv2__Preferred_Spouse__r.LastName},
{!$Record.FirstName} + &apos; and &apos; + {!$Record.ucinn_ascendv2__Preferred_Spouse__r.FirstName} + &apos; &apos; + {!$Record.LastName},
{!$Record.FirstName} + &apos; &apos; + {!$Record.LastName} + &apos; and &apos; + {!$Record.ucinn_ascendv2__Preferred_Spouse__r.FirstName} + &apos; &apos; + {!$Record.ucinn_ascendv2__Preferred_Spouse__r.LastName})
)</expression>
    </formulas>
    <formulas>
        <description>This formula stores the format for the Joint Modern Name salutation</description>
        <name>fx_Joint_SameHousehold_ModernName</name>
        <dataType>String</dataType>
        <expression>IF(
{!$Record.LastName} = {!$Record.ucinn_ascendv2__Preferred_Spouse__r.LastName},
{!$Record.Account.ucinn_ascendv2__Primary_Contact__r.FirstName} + &apos; and &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.ucinn_ascendv2__Preferred_Spouse__r.FirstName} + &apos; &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.LastName},
{!$Record.Account.ucinn_ascendv2__Primary_Contact__r.FirstName} + &apos; &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.LastName} + &apos; and &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.ucinn_ascendv2__Preferred_Spouse__r.FirstName} + &apos; &apos; + {!$Record.Account.ucinn_ascendv2__Primary_Contact__r.ucinn_ascendv2__Preferred_Spouse__r.LastName}
)</expression>
    </formulas>
    <formulas>
        <name>fx_LoopCounter</name>
        <dataType>Number</dataType>
        <expression>{!DupeLoopCounter} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>This formula stores the logic for the Single - Modern Name format</description>
        <name>fx_Single_ModernName</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName} + &apos; &apos; + {!$Record.LastName}</expression>
    </formulas>
    <formulas>
