            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>semicolonAfter</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>;</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>semicolonBefore</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>;</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>semicolonBefore</assignToReference>
